temporal --update-config
ssmock start -config ssmock.toml --update-config
migrate load-input
migrate worker &worker&
migrate update-index
kill worker

stderr 'Workflow completed\..*Elasticsearch update skipped: package status is UPLOADED at location /api/v2/location/72a9c518-2747-4cb5-aeba-e6309d946e79/'
exec sqlite3 -header -csv migrate.db 'SELECT uuid,status,found,moved FROM aips;'
cmp stdout db.aips.expected.csv

