temporal --update-config
esmock --update-config
ssmock start -config ssmock.toml --update-config
migrate export move
migrate worker &worker&
migrate update-index --all-in-target-location --dry-run
kill worker

stderr 'Workflow completed\..*AIP_UpdateIndex_2faa61dc-ed33-49f4-8b36-954f203bab4a.*Dry run: would update Elasticsearch fields: location, filePath'
stderr 'Workflow completed\..*AIP_UpdateIndex_daa05a8c-ec53-4c27-968a-6e6bdba905ce.*Dry run: would update Elasticsearch fields: location, filePath'
stderr 'Update-index summary\..*total=2.*would_update=2.*no_change=0.*skipped=0'

